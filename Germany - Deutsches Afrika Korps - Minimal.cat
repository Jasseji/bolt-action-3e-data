            <selectionEntry type="upgrade" name="Inexperienced" id="6e34-04d0-0b6d-e751">
              <costs>
                <cost name="Points" typeId="d4a9-f78c-67cc-4b69" value="35" />
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Options" id="0a6b-8a9c-4e82-cb60">
          <selectionEntries>
            <selectionEntry type="upgrade" name="Add up to 5 men with rifles at +7pts each" id="0bd0-ee18-7af7-886b">
              <constraints>
                <constraint type="max" value="5" field="selections" scope="parent" shared="false" id="4e2a-b778-487e-aa95" />
