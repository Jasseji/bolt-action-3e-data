        <profile name="Sd.Kfz 221" hidden="false" id="5d40-aead-7aa6-8637" typeId="9b00-0000-0000-0001" typeName="Army Book Unit">
          <characteristics>
            <characteristic name="Period" typeId="9b01-0000-0000-0001">E/M</characteristic>
            <characteristic name="Composition / Type" typeId="9b01-0000-0000-0002">7+ (armoured car)</characteristic>
            <characteristic name="Weapons" typeId="9b01-0000-0000-0003">1 turret-mounted MMG</characteristic>
            <characteristic name="Rules and options" typeId="9b01-0000-0000-0004">Open-topped; Recce; Flak; Panzerbüchse: Counts as a light anti-tank gun, and in addition its squeeze-bore system means that ranges of up to 12”, its base armour penetration is increased by 2 to a total of +6, at over half range armour penetration is reduced by 2 instead of the usual 1 to a total of +2.; Loses the Flak special rule and replace the MMG with an anti-tank rifle for free, or with a Panzerbüchse for +35pts</characteristic>
            <characteristic name="Army Book" typeId="9b01-0000-0000-0005">p. 81</characteristic>
          </characteristics>
        </profile>
      </profiles>
