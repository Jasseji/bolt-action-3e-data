      <profiles>
        <profile name="Pantherturm" hidden="false" id="bc22-a954-776c-19b2" typeId="9b00-0000-0000-0001" typeName="Army Book Unit">
          <characteristics>
            <characteristic name="Period" typeId="9b01-0000-0000-0001">L</characteristic>
            <characteristic name="Composition / Type" typeId="9b01-0000-0000-0002">10+ (heavy tank)</characteristic>
            <characteristic name="Weapons" typeId="9b01-0000-0000-0003">1 turret-mounted super-heavy anti-tank gun with co-axial MMG</characteristic>
            <characteristic name="Rules and options" typeId="9b01-0000-0000-0004">Fortification Gun. This vehicle starts the game having already suffered an Immobilised result. In scenarios that do not allow units to start on the table, place this unit in base contact with your table edge as soon as you know which side of the table is yours.; Engineering Selection: 0-2 of these vehicles can also be taken in an Engineer Platoon instead of one or both of the non- mandatory Engineer squads. T ANK DESTROYERS AND ASSAUL T GUNS Normally based on a tank chassis, German tank destroyers and assault guns replaced the turret-mounted weaponry with a cannon mounted directly into an armoured glacis at the front of the hull. This limited their manoeuvrability, as the traversing ability of the main gun was very restricted, but it gave the vehicle a very low profile and, more importantly, it made it a lot easier and cheaper to produce than an equivalent tank.</characteristic>
            <characteristic name="Army Book" typeId="9b01-0000-0000-0005">p. 64</characteristic>
          </characteristics>
        </profile>
      </profiles>
