    <selectionEntry type="unit" import="true" name="Feldgendarmerie Squad" hidden="false" id="932c-2242-a4f4-04c5">
      <categoryLinks>
        <categoryLink targetId="d42d-87f6-d04b-43db" id="048f-5b2b-4730-a639" primary="true" name="Infantry" />
        <categoryLink targetId="9e10-0000-0000-0001" id="1cce-9803-6976-3d9b" primary="false" name="Period: Early War" />
        <categoryLink targetId="9e10-0000-0000-0002" id="964f-9648-b767-be49" primary="false" name="Period: Mid War" />
