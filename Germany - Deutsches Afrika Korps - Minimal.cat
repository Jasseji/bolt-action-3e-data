              <constraints>
                <constraint type="max" value="10" field="selections" scope="parent" shared="false" id="4484-f3ad-f28f-f0d0" />
              </constraints>
              <costs>
                <cost name="Points" typeId="d4a9-f78c-67cc-4b69" value="4" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Up to 1 man may replace their rifle with a light machine gun for +15pts - another man becomes the loader" id="0c80-4a92-88e9-504c">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="false" id="41f9-12cd-c396-fb2e" />
              </constraints>
              <costs>
                <cost name="Points" typeId="d4a9-f78c-67cc-4b69" value="15" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Up to 4 men may have a panzerfaust in addition to other weapons for +15pts each" id="74b7-34df-99ee-5229">
              <constraints>
                <constraint type="max" value="4" field="selections" scope="parent" shared="false" id="3373-2a3c-ebc5-f902" />
