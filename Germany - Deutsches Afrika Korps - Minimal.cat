    <selectionEntry type="unit" import="true" name="Officer" hidden="false" id="322f-0bbc-f08a-0dab">
      <categoryLinks>
        <categoryLink targetId="2b35-7c65-b12a-4aca" id="d2db-5265-e293-9c12" primary="true" name="Command" />
        <categoryLink targetId="9e10-0000-0000-0001" id="1207-c7bd-8681-51d7" primary="false" name="Period: Early War" />
