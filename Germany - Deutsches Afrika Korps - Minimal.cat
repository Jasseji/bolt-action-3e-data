        <profile name="Sd.Kfz 231 Heavy Armoured Car (8-Rad)" hidden="false" id="b18d-5f9b-d46d-4f15" typeId="9b00-0000-0000-0001" typeName="Army Book Unit">
          <characteristics>
            <characteristic name="Period" typeId="9b01-0000-0000-0001">E/M</characteristic>
            <characteristic name="Composition / Type" typeId="9b01-0000-0000-0002">7+ (armoured car)</characteristic>
            <characteristic name="Weapons" typeId="9b01-0000-0000-0003">removed from Panzer IV tanks as those tanks were up-gunned. Principal service: 1941-43. Numbers manufactured: 700 (both variants). Cost (Inexperienced), 95pts (Regular), 114pts (Veteran) Weapons 1 turret-mounted light autocannon and co-axial MMG</characteristic>
            <characteristic name="Rules and options" typeId="9b01-0000-0000-0004">Recce (dual direction steering); Open-topped (Sd.Kfz 233 only); Replace light autocannon and co-axial machine gun with a hull-mounted front-facing light howitzer for free (Sd.Kfz 233). The Sd.Kfz 233 can also been given a pintle-mounted MMG covering the front and right arc for +15pts.</characteristic>
            <characteristic name="Army Book" typeId="9b01-0000-0000-0005">p. 82</characteristic>
          </characteristics>
        </profile>
      </profiles>
