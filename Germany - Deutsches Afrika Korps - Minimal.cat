      <profiles>
        <profile name="Cossack Unit" hidden="false" id="5f31-cd08-1611-911f" typeId="9b00-0000-0000-0001" typeName="Army Book Unit">
          <characteristics>
            <characteristic name="Period" typeId="9b01-0000-0000-0001">M/L</characteristic>
            <characteristic name="Composition / Type" typeId="9b01-0000-0000-0002">1 NCO and 4 men</characteristic>
            <characteristic name="Weapons" typeId="9b01-0000-0000-0003">Cavalry carbines (see below)</characteristic>
            <characteristic name="Rules and options" typeId="9b01-0000-0000-0004">Cavalry (If horses taken); Cavalry Carbines: These short-barrelled rifles count as pistols when used from horseback, and rifles when used on foot; Skilled riders: Cossacks treat obstacles as open ground while mounted (except when assaulting defended obstacles).; Behind enemy lines: When outflanking as described in the Bolt Action rulebook, Cossack units ignore the -1 modifier to the order test for coming onto the table.; Add up to 5 men with carbines for +11pts (Regular) or +14pts (Veteran) each.; The NCO and up to 2 men may replace their carbines with submachine guns for +4pts.; Up to 1 man may replace their carbine with a light machine gun for +15pts - another man becomes the loader.; Up to 1 man may have a panzerfaust in addition to other weapons for +15pts; The squad may be mounted on horses for + 4pts per figure</characteristic>
            <characteristic name="Army Book" typeId="9b01-0000-0000-0005">p. 39</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Experience" id="089f-eb06-1e2b-cb29">
