    <selectionEntry type="unit" import="true" name="Panzer I Ausf. C" hidden="false" id="8c33-da65-f9f7-2b90">
      <categoryLinks>
        <categoryLink targetId="6912-835d-246f-48a2" id="1a21-f10a-812d-ea5f" primary="true" name="Armour" />
        <categoryLink targetId="9e10-0000-0000-0003" id="8096-26b6-c6e0-07d1" primary="false" name="Period: Late War" />
