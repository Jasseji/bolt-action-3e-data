          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Options" id="b3c3-97f3-5b71-c2bf">
          <selectionEntries>
            <selectionEntry type="upgrade" name="Upgrade the low-velocity light anti-tank gun to light anti-tank gun (SA38) for +10pts" id="b1bf-5f62-3c02-5f82">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="false" id="e252-8901-3e80-c47d" />
              </constraints>
              <costs>
                <cost name="Points" typeId="d4a9-f78c-67cc-4b69" value="10" />
              </costs>
            </selectionEntry>
            <selectionEntry type="upgrade" name="Add 28/32cm Wurfrahmen rocket launcher frame for +55pts (a forward-facing multiple rocket launcher is added to this tank’s weapons)." id="3518-7811-cb0f-2dcb">
              <constraints>
                <constraint type="max" value="28" field="selections" scope="parent" shared="false" id="74f7-acbc-7a70-ee4e" />
