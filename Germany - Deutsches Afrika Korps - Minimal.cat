        <profile name="Sturmpioniere (Assault Engineer) Squad" hidden="false" id="b274-35c0-0237-5725" typeId="9b00-0000-0000-0001" typeName="Army Book Unit">
          <characteristics>
            <characteristic name="Period" typeId="9b01-0000-0000-0001">E/M/L</characteristic>
            <characteristic name="Composition / Type" typeId="9b01-0000-0000-0002">1 NCO and 4 men</characteristic>
            <characteristic name="Weapons" typeId="9b01-0000-0000-0003">Rifles</characteristic>
            <characteristic name="Rules and options" typeId="9b01-0000-0000-0004">Engineers; Tank hunters (if anti-tank grenades taken); GrB-39 grenade launcher: Every time the man fires this weapon, you can choose either of the two profiles below: Type Range Shots Pen Special Rules GrB-39 (Anti-Personnel) 24” 1 HE HE (1”) GrB-39 (Anti-tank) 24” 1 +3 Shaped charge Sturmpistole 6” 1 +3 Shaped Charge; Add up to 5 men with rifles at +14pts each; The NCO and up to 6 men may replace their rifles with submachine guns for +4pts each; Up to 1 man may replace their rifle with a light machine gun for +15pts - another man becomes the loader; Up to 1 man can replace their rifle with a flamethrower for +30pts - another man becomes the assistant; Up to 1 man can replace their rifle with a sturmpistole for +5pts; Up to 1 man can replace their rifle with a GrB-39 grenade launcher for +30pts - another man becomes the loader; Up to 4 men may have a panzerfaust in addition to other weapons for +15pts each (Only Mid and Late-War); The squad may be given anti-tank grenades for +2pts per figure</characteristic>
            <characteristic name="Army Book" typeId="9b01-0000-0000-0005">p. 45</characteristic>
          </characteristics>
        </profile>
