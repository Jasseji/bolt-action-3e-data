        <infoLink name="Initiative Training" hidden="false" type="rule" id="a7da-69be-55d0-efde" targetId="a300-0000-0000-0003" />
      </infoLinks>
      <profiles>
        <profile name="Fallschirmjäger Squad (Early War)" hidden="false" id="04d4-927c-2134-82cf" typeId="9b00-0000-0000-0001" typeName="Army Book Unit">
          <characteristics>
            <characteristic name="Period" typeId="9b01-0000-0000-0001">E/M</characteristic>
            <characteristic name="Composition / Type" typeId="9b01-0000-0000-0002">1 NCO and 4 men</characteristic>
            <characteristic name="Weapons" typeId="9b01-0000-0000-0003">, including rifles and submachine guns, were dropped separately in canisters, meaning that once upon the ground they were unarmed until the canisters were recovered. These rules assume the canister has already been recovered. During the assault on the Belgian fortress of Eben Emael the Fallschirmjäger used specialist charges to blast open the fortress doors. Cost 70pts (Veteran) Composition 1 NCO and 4 men Weapons Rifles</characteristic>
            <characteristic name="Rules and options" typeId="9b01-0000-0000-0004">Tank hunters (if anti-tank grenades taken); Stubborn German Fallschirmjäger Squad; Add up to 5 men with rifles at +14pts each; The NCO and up to 2 men may replace their rifles with submachine guns for +4pts; Up to 1 man may replace their rifle with a light machine gun for +15pts - another man becomes the loader.; Anybody may replace their rifle with a pistol for -1pt each; The squad may be given anti-tank grenades instead for +2pts each</characteristic>
            <characteristic name="Army Book" typeId="9b01-0000-0000-0005">p. 39</characteristic>
          </characteristics>
        </profile>
      </profiles>
