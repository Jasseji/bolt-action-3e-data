              <constraints>
                <constraint type="max" value="10" field="selections" scope="parent" shared="false" id="467c-c6ee-2330-1a6f" />
              </constraints>
              <costs>
                <cost name="Points" typeId="d4a9-f78c-67cc-4b69" value="6" />
              </costs>
            </selectionEntry>
