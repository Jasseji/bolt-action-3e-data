    <selectionEntry type="unit" import="true" name="Begleit - StuG Escort Infantry Squad" hidden="false" id="f461-f30b-4f00-4ce5">
      <categoryLinks>
        <categoryLink targetId="d42d-87f6-d04b-43db" id="3560-5492-d19a-2991" primary="true" name="Infantry" />
        <categoryLink targetId="9e10-0000-0000-0002" id="08db-f0f5-8cb0-9929" primary="false" name="Period: Mid War" />
        <categoryLink targetId="9e10-0000-0000-0003" id="775d-2bf6-1bf7-8afe" primary="false" name="Period: Late War" />
      </categoryLinks>
      <infoLinks>
        <infoLink name="Hitler's Buzz-Saw" hidden="false" type="rule" id="c526-9d64-bd04-5499" targetId="a300-0000-0000-0001" />
        <infoLink name="Initiative Training" hidden="false" type="rule" id="b07d-9491-ff13-d6a9" targetId="a300-0000-0000-0003" />
      </infoLinks>
      <profiles>
        <profile name="Begleit - StuG Escort Infantry Squad" hidden="false" id="8225-2726-2f1c-d1e0" typeId="9b00-0000-0000-0001" typeName="Army Book Unit">
          <characteristics>
            <characteristic name="Period" typeId="9b01-0000-0000-0001">M/L</characteristic>
            <characteristic name="Composition / Type" typeId="9b01-0000-0000-0002">1 NCO and 4 men</characteristic>
            <characteristic name="Weapons" typeId="9b01-0000-0000-0003">Rifles</characteristic>
            <characteristic name="Rules and options" typeId="9b01-0000-0000-0004">StuG riders: StuG riders may be used as follows with StuG III Ausf. F,G and H, StuG IV, StuH 42 and StuG 32b. A StuG rider unit can mount or dismount from a StuG counting it as a transport for these purposes. One unit of assault gun riders can ride upon one StuG. As with other transported units the unit cannot be targeted whilst they ride upon their StuG; however, unlike with other troops, StuG riders must immediately disembark if the StuG they are riding upon is shot at. Regardless of what kind of weapon is shooting at the StuG, as long as the firer is within range of the vehicle the StuG riders disembark when the shot is declared and before rolling the dice to determine hits against the StuG. Units disembarking in this way follow the rules for units forced to disembark from a transport that is immobilised or set on fire, as described in the Bolt Action rulebook.; Add up to 5 men with rifles for +10pts (regular) or +13pts (veteran) each; The NCO and up to 6 men may replace their rifles with submachine guns for +4 pts each; The NCO and up to 6 men may replace their rifles with assault rifles for +6pts each; Up to 1 man may replace their rifle with a light machine gun for +15 pts - another man becomes the loader.; Up to 1 man may have a panzerfaust in addition to other weapons for +15pts</characteristic>
            <characteristic name="Army Book" typeId="9b01-0000-0000-0005">p. 36</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Experience" id="b614-d533-6199-9d54">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="false" id="4f09-bff8-4abd-14b8" />
            <constraint type="max" value="1" field="selections" scope="parent" shared="false" id="827a-573e-653b-0c1e" />
