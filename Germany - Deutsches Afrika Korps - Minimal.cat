    <selectionEntry type="unit" import="true" name="105MM LG40/1" hidden="false" id="b4a6-7b58-083d-74ad">
      <categoryLinks>
        <categoryLink targetId="3c3f-de12-7949-45f5" id="754e-7739-07b9-923d" primary="true" name="Artillery" />
