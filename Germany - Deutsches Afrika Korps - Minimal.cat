      <profiles>
        <profile name="Chaplain" hidden="false" id="6507-6959-e9fb-0708" typeId="9b00-0000-0000-0001" typeName="Army Book Unit">
          <characteristics>
            <characteristic name="Period" typeId="9b01-0000-0000-0001">E/M/L</characteristic>
            <characteristic name="Composition / Type" typeId="9b01-0000-0000-0002">1 Chaplain</characteristic>
            <characteristic name="Weapons" typeId="9b01-0000-0000-0003">None</characteristic>
            <characteristic name="Rules and options" typeId="9b01-0000-0000-0004">Special Rules:; HQ choice: A force can include a single Chaplain, who is not part of any of the platoon selectors, in the same manner as the Company commander (see the Bolt Action rulebook).; Self-defence: see the Medic entry in the Bolt Action rulebook, page 113; Inspiring presence: Upon receiving his order dice (except for Down), a chaplain may select 1 friendly unit within 6” and roll a D6, applying the following modifiers: Inexperienced -1, Veteran +1. On a 4+, the chaplain may remove 1 pin from the selected unit.</characteristic>
            <characteristic name="Army Book" typeId="9b01-0000-0000-0005">p. 27</characteristic>
          </characteristics>
        </profile>
      </profiles>
