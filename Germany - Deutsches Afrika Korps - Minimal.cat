    <selectionEntry type="unit" import="true" name="Brandenburger Special Forces Squad" hidden="false" id="d2d2-ef95-9407-a47b">
      <categoryLinks>
        <categoryLink targetId="d42d-87f6-d04b-43db" id="086e-cbdd-93ec-7e8a" primary="true" name="Infantry" />
        <categoryLink targetId="9e10-0000-0000-0001" id="319f-4a8e-d985-37e3" primary="false" name="Period: Early War" />
        <categoryLink targetId="9e10-0000-0000-0002" id="e78e-bac6-0fa4-32f0" primary="false" name="Period: Mid War" />
        <categoryLink targetId="9e10-0000-0000-0003" id="287a-7e15-ba26-b2a1" primary="false" name="Period: Late War" />
      </categoryLinks>
      <infoLinks>
        <infoLink name="Hitler's Buzz-Saw" hidden="false" type="rule" id="a47f-f800-9716-22ef" targetId="a300-0000-0000-0001" />
        <infoLink name="Initiative Training" hidden="false" type="rule" id="c9a2-9a55-6f87-77c3" targetId="a300-0000-0000-0003" />
      </infoLinks>
      <profiles>
        <profile name="Brandenburger Special Forces Squad" hidden="false" id="2143-4614-0149-bd1c" typeId="9b00-0000-0000-0001" typeName="Army Book Unit">
          <characteristics>
            <characteristic name="Period" typeId="9b01-0000-0000-0001">E/M/L</characteristic>
            <characteristic name="Composition / Type" typeId="9b01-0000-0000-0002">1 NCO and 4 men</characteristic>
            <characteristic name="Weapons" typeId="9b01-0000-0000-0003">Rifles</characteristic>
            <characteristic name="Rules and options" typeId="9b01-0000-0000-0004">Elite of the elite! To represent their special training and motivation, Brandenburger units have the Tough Fighters and Fanatics special rules.; Behind enemy lines: When outflanking as described in the Bolt Action rulebook, Brandenburger units ignore the -1 modifier to the order test for coming onto the table.; Sabotage! Enemy units in reserve suffer an additional -1 modifier on the test to come onto the table.; Paranoia: When the enemy rolls on the FUBAR chart, they suffer a -2 modifier to the roll, such is the paranoia induced in the enemy by the Brandenburgers’ irregular activities.; Tank hunters (if anti-tank grenades taken); Add up to 5 men with rifles for +19pts each; Anybody may replace their rifle with a submachine gun for +4pts; Up to 2 men may have light machine guns for +15pts each. For each LMG, another man becomes the loader; Anybody may replace their rifle with a pistol for -1pt each; The squad may be given anti-tank grenades for +2pts per figure</characteristic>
            <characteristic name="Army Book" typeId="9b01-0000-0000-0005">p. 36</characteristic>
          </characteristics>
        </profile>
